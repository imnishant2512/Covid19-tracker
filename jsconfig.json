{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // TypeScript 7 defaults strict on, where 5 did not. Enabling it here
    // surfaces 51 findings, mostly implicit-any parameters in the specs. Worth
    // doing as its own piece of work; not as a side effect of a dependency
    // upgrade. Run `npx tsc -p jsconfig.json --noEmit --strict` to see them.
    "strict": false,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vitest/globals",
      "node",
      "vite/client"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src",
    "scripts",
    "e2e",
    "vite.config.js",
    "eslint.config.js",
    "playwright.config.js"
  ],
  "exclude": [
    "node_modules",
    "build",
    "coverage",
    "test-results",
    "playwright-report"
  ]
}
